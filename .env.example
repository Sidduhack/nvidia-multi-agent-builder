# NVIDIA hosted NIM configuration
# Copy this file to .env locally. Never commit your real API key.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REQUEST_TIMEOUT_SECONDS=60

# Model IDs are intentionally configurable. Verify exact IDs on NVIDIA Build
# before assigning them in a deployment.
NVIDIA_MODEL_DEFAULT=
NVIDIA_MODEL_PLANNER=
NVIDIA_MODEL_ARCHITECT=
NVIDIA_MODEL_UI_UX=
NVIDIA_MODEL_FRONTEND=
NVIDIA_MODEL_BACKEND=
NVIDIA_MODEL_DATABASE=
NVIDIA_MODEL_SECURITY=
NVIDIA_MODEL_REVIEWER=
NVIDIA_MODEL_TESTING=
NVIDIA_MODEL_DEBUGGING=
NVIDIA_MODEL_PERFORMANCE=
NVIDIA_MODEL_INTEGRATION=
