# Copy this file to .env locally. Never commit .env or real credentials.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Safety/cost controls for the free-first MVP.
MAX_PARALLEL_AGENTS=2
MAX_AGENT_CALLS=20
MAX_AGENT_RETRIES=2
MAX_REPAIR_CYCLES=3
REQUEST_TIMEOUT_SECONDS=120
